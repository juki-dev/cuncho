# Variables que docker compose interpola en docker-compose.yml.
# Copiar a .env (ignorado por git) y rellenar.

# API key de CARTO basemaps (https://carto.com/basemaps). Es pública: viaja en la
# URL de cada tile, así que restríngela por dominio en el panel de CARTO.
VITE_CARTO_KEY=

# false para que el frontend le pegue a la api de este compose en vez de a MSW.
VITE_API_MOCKS=true
