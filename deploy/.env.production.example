# Copia a /opt/cuncho/.env en el servidor (permisos 600). NUNCA al repositorio.
# Genera secretos con: openssl rand -base64 48

# --- Base de datos (PostGIS dentro de Compose; no se publica) ---
DB_USER=cuncho
DB_NAME=cuncho
DB_PASSWORD=CAMBIAR_contraseña_larga_aleatoria

# --- API ---
LOG_LEVEL=info
CORS_ORIGINS=https://cuncho.jukidev.com
JWT_ACCESS_SECRET=CAMBIAR_minimo_32_caracteres_aleatorios
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10
RECOMMENDATION_DEFAULT_RADIUS_KM=2.5
RECOMMENDATION_MAX_RADIUS_KM=25
RECOMMENDATION_WEIGHT_JACCARD=0.60
RECOMMENDATION_WEIGHT_DISTANCE=0.25
RECOMMENDATION_WEIGHT_SCORE=0.15
RECOMMENDATION_MAX_RESULTS=20
# SWAGGER_ENABLED, TRUST_PROXY, NODE_ENV, DB_HOST... los fija docker-compose.prod.yml.

# --- Proxy ---
API_DOMAIN=cuncho-api.jukidev.com

# --- Límites de memoria (súbelos al escalar el servidor) ---
# 1 GB: db 384m + api 320m + caddy 64m. 2 GB: DB_MEM_LIMIT=768m API_MEM_LIMIT=512m
DB_MEM_LIMIT=384m
API_MEM_LIMIT=320m

# --- Backups (salida de `terraform output` en infra/backend; NO se pasan a los contenedores) ---
BACKUP_BUCKET=CAMBIAR
BACKUP_AWS_ACCESS_KEY_ID=CAMBIAR
BACKUP_AWS_SECRET_ACCESS_KEY=CAMBIAR
BACKUP_AWS_REGION=us-east-1
