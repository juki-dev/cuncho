# URL base de la API Nest.js (se inyecta al compilar; un build por ambiente)
VITE_API_URL=https://api.example.com
# Usa MSW con datos de ejemplo en lugar de la API real
VITE_API_MOCKS=false
# Centro del mapa cuando no hay GPS: "lat,lng"
VITE_MAP_DEFAULT_CENTER=4.6097,-74.0817
# API key de CARTO basemaps (https://carto.com/basemaps/apikey). Ponla en .env.local, no en el repo.
VITE_CARTO_KEY=
